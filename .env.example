# Copie este arquivo para ".env" e troque pelo endereço do seu back-end no Render.
# Com https://, sem barra no final, e terminando em /api
# NA VERCEL: o arquivo .env NÃO é enviado. Cadastre as mesmas variáveis em Settings > Environment Variables e faça um Redeploy.
NUXT_DJANGO_API=https://tcc-back-end-1-j9p6.onrender.com/api
NUXT_DJANGO_AUTH_SCHEME=Bearer

# Limite total por envio de fotos/mídias pelo servidor do site. A Vercel aceita no máximo 4,5 MB por pedido; no seu computador pode subir (ex.: 20).
NUXT_PUBLIC_MAX_UPLOAD_MB=4

# Só se a rota de comentários do Django não for descoberta automaticamente (veja o LEIA-ME). {id} é o id do post.
# NUXT_COMMENTS_PATH=/comentario/{id}/
