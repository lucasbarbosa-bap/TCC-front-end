# Copie este arquivo para ".env" e troque pelo endereço do seu back-end no Render.
# Sem barra no final, e com /api no fim.
NUXT_DJANGO_API=https://tcc-back-end-1-j9p6.onrender.com/api
# Se o login do Django usar "Token xxxx" em vez de "Bearer xxxx", troque aqui.
NUXT_DJANGO_AUTH_SCHEME=Bearer

# --- Envio de fotos e mídias ---
# Limite total por envio pelo servidor do site. A Vercel aceita no máximo 4,5 MB por pedido; no seu computador pode subir (ex.: 20).
NUXT_PUBLIC_MAX_UPLOAD_MB=4
# Para enviar arquivos grandes, descomente: o navegador envia direto ao Django (exige CORS no Django).
# NUXT_PUBLIC_DJANGO_DIRECT=https://tcc-back-end-1-j9p6.onrender.com/api
